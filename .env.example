# Rajab Electricians & Solar Installation - Environment Variables Example
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/rajab_db?schema=public"

# Auth Secret
JWT_SECRET="replace_with_a_secure_random_32_char_secret_key"
JWT_EXPIRES_IN="7d"

# Business Information
NEXT_PUBLIC_COMPANY_NAME="Rajab Electricians & Solar Installation"
NEXT_PUBLIC_PHONE="+92 328 7848708"
NEXT_PUBLIC_WHATSAPP="+923287848708"
NEXT_PUBLIC_EMAIL="rajabelectricianfsd@gmail.com"
NEXT_PUBLIC_ADDRESS="Himmatpura, Street No. 12, Faisalabad, 38000, Pakistan"
NEXT_PUBLIC_GOOGLE_RATING="4.8"
NEXT_PUBLIC_REVIEW_COUNT="12"

# Solar Calculator Default Weights
DEFAULT_SOLAR_RATE_PER_WATT=120
DEFAULT_NET_METERING_COST=85000
DEFAULT_AVG_UNIT_COST=62

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@rajabelectricians.pk"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM="\"Rajab Electricians\" <notifications@rajabelectricians.pk>"
